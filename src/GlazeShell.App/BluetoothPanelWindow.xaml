<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.BluetoothPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Фон панели — то же стекло, что у верхней полосы: у окна свой такой же
        Acrylic-backdrop с прозрачностью верхней панели, поэтому кисть должна совпадать
        с полосой по альфе. Градиент GlazeGlassBrush предназначен для popover внутри
        окна полосы и плотнее её (до 70 % прозрачности) — здесь он делал панель заметно
        плотнее полосы.
    -->
    <Grid x:Name="Root" Padding="20" UseLayoutRounding="True" Background="{StaticResource GlazeTopBarGlassBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{StaticResource GlazePanelTextPrimaryBrush}"
            Text="Bluetooth" />

        <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,14">
            <TextBlock
                x:Name="StatusText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource GlazePanelTextPrimaryBrush}" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                Foreground="{StaticResource GlazePanelTextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DevicesList" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,10"
                                Margin="0,0,0,6"
                                Background="{StaticResource GlazeTopBarPillBrush}"
                                BorderBrush="{StaticResource GlazeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource GlazePanelTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource GlazePanelTextSecondaryBrush}"
                                        Text="{Binding Status}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                x:Name="EmptyText"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="12"
                Foreground="{StaticResource GlazePanelTextSecondaryBrush}"
                Text="Нет сопряжённых устройств"
                Visibility="Collapsed" />
        </Grid>

        <Button
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Click="OnOpenSettings">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
                <TextBlock FontSize="12" Text="Настройки Bluetooth" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
