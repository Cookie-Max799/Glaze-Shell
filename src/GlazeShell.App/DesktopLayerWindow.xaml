<Window
    x:Class="GlazeShell.App.DesktopLayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" Background="Transparent">
        <ItemsControl x:Name="IconsHost" ItemsSource="{x:Bind ViewModel.Icons, Mode=OneWay}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:DesktopIconViewModel"
                              xmlns:local="using:GlazeShell.App.Presentation">
                    <Grid
                        Width="88" Height="104"
                        Canvas.Left="{x:Bind X, Mode=OneWay}"
                        Canvas.Top="{x:Bind Y, Mode=OneWay}"
                        Background="Transparent"
                        DoubleTapped="OnIconDoubleTapped"
                        RightTapped="OnIconRightTapped">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="56" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            x:Name="IconPlate"
                            Grid.Row="0"
                            Width="48" Height="48"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                            <Grid>
                                <Border
                                    Background="{x:Bind FallbackBrush, Mode=OneWay}"
                                    CornerRadius="10"
                                    Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind Initial, Mode=OneWay}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White" />
                                </Border>

                                <Image
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Width="48" Height="48"
                                    Visibility="{x:Bind IconVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <TextBlock
                            Grid.Row="1"
                            Text="{x:Bind Name, Mode=OneWay}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            FontSize="12"
                            Margin="4,6,4,0"
                            HorizontalAlignment="Center"
                            Foreground="White" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
