<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.TopBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <!--
        Окно верхней панели (A6). Стекло рисует системный acrylic-backdrop. Окно занимает
        всю ширину экрана: видна полоса сверху с нижним скруглением, которая в покое лишь
        чуть выезжает из-за верхнего края, а при наведении раскрывается полностью.
        Панель результатов Glance и popover живут в этом же окне.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- Полноширинная стеклянная полоса с нижним скруглением -->
        <Border
            x:Name="BarBackground"
            Height="30"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{StaticResource GlazeGlassBrush}"
            BorderThickness="0"
            CornerRadius="0,0,24,24"
            IsHitTestVisible="False" />

        <Grid x:Name="Layout" Margin="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="26" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Левая плитка: активное приложение (DESIGN §7.1) — значок, имя и заголовок окна.  -->
            <Border
                x:Name="AppPill"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,3"
                Padding="4,0,10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Активное приложение"
                Background="{StaticResource GlazeElevatedBrush}"
                CornerRadius="10"
                IsHitTestVisible="False">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="7"
                    VerticalAlignment="Center">
                    <Grid
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center">
                        <Border
                            Background="{StaticResource GlazeBrandGradientBrush}"
                            CornerRadius="5"
                            Visibility="{x:Bind ViewModel.IsAppIconFallback, Mode=OneWay}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GlazeWhiteBrush}"
                                Text="{x:Bind ViewModel.AppInitial, Mode=OneWay}" />
                        </Border>
                        <Image
                            Width="16"
                            Height="16"
                            Source="{x:Bind ViewModel.AppIcon, Mode=OneWay}"
                            Stretch="Uniform"
                            Visibility="{x:Bind ViewModel.HasAppIcon, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        MaxWidth="150"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GlazeTextPrimaryBrush}"
                        Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="8"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Glyph="&#xE70D;"
                        Visibility="{x:Bind ViewModel.HasLocation, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="240"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.AppLocation, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind ViewModel.HasLocation, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!--  Центральная плитка: поиск. Поле живёт в самой панели, а не в popup:
                  иначе клик по нему не доходит до окна, показанного без активации.  -->
            <Grid
                x:Name="SearchHit"
                Grid.Row="0"
                Grid.Column="1"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                AutomationProperties.Name="Поиск">
                <Border
                    x:Name="SearchPill"
                    Width="440"
                    Height="20"
                    Padding="8,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource GlazeElevatedBrush}"
                    CornerRadius="10">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Glyph="&#xE721;" />

                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="1"
                            MinHeight="0"
                            Padding="0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            AutomationProperties.Name="Поиск приложений, файлов, настроек"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            GotFocus="OnSearchGotFocus"
                            KeyDown="OnSearchKeyDown"
                            LostFocus="OnSearchLostFocus"
                            PlaceholderForeground="{StaticResource GlazeTextSecondaryBrush}"
                            PlaceholderText="Поиск приложений, файлов, настроек…"
                            PointerPressed="OnSearchPointerPressed"
                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            UseSystemFocusVisuals="False">
                            <TextBox.Resources>
                                <!--  Поле поиска рисуется без собственной рамки и фона:
                                      стекло панели остаётся единственной поверхностью.  -->
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <Thickness x:Key="TextControlThemePadding">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>

                        <Border
                            Grid.Column="2"
                            Padding="5,1"
                            VerticalAlignment="Center"
                            Background="{StaticResource GlazeSurfaceBrush}"
                            CornerRadius="6">
                            <TextBlock
                                FontSize="9.5"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Ctrl K" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!--  Правая плитка: статус (сеть, звук, батарея) и часы (DESIGN §7.1).  -->
            <Border
                x:Name="StatusPill"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,3"
                Padding="10,0"
                AutomationProperties.Name="Центр управления"
                Background="{StaticResource GlazeElevatedBrush}"
                CornerRadius="10"
                IsTabStop="True"
                KeyDown="OnStatusKeyDown"
                PointerPressed="OnStatusPointerPressed">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.NetworkGlyph, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NetworkText, Mode=OneWay}" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.QuickSettings.VolumeGlyph, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.QuickSettings.VolumeLabel, Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="3"
                        AutomationProperties.Name="Питание"
                        ToolTipService.ToolTip="Питание"
                        Visibility="{x:Bind ViewModel.HasBattery, Mode=OneWay}">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="CpuBlock"
                        MinWidth="46"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.CpuText, Mode=OneWay}"
                        TextAlignment="Right"
                        ToolTipService.ToolTip="Загрузка процессора" />

                    <TextBlock
                        MinWidth="46"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.GpuText, Mode=OneWay}"
                        FontSize="11"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.GpuText, Mode=OneWay}"
                        TextAlignment="Right"
                        ToolTipService.ToolTip="Загрузка графического процессора"
                        Visibility="{x:Bind ViewModel.HasGpu, Mode=OneWay}" />

                    <Rectangle
                        Width="1"
                        Height="14"
                        Fill="{StaticResource GlazeTextMutedBrush}"
                        Opacity="0.4" />

                    <Button
                        x:Name="ClockButton"
                        Height="20"
                        Padding="2,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Дата и время — открыть календарь"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClockClick"
                        CornerRadius="6"
                        HorizontalContentAlignment="Right"
                        ToolTipService.ToolTip="Календарь">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            AutomationProperties.Name="Дата и время">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                Text="{x:Bind ViewModel.ClockTime, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ClockDate, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Панель результатов Glance (B1) под строкой поиска: та же колонка, что и поиск.  -->
            <Border
                x:Name="ResultsPanel"
                Grid.Row="1"
                Grid.Column="1"
                Width="440"
                Margin="0,6,0,0"
                Padding="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource GlazeGlassBrush}"
                BorderThickness="0"
                CornerRadius="32"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                <Grid>
                    <ListView
                        x:Name="ResultsList"
                        MaxHeight="336"
                        Background="Transparent"
                        IsItemClickEnabled="True"
                        ItemClick="OnResultClicked"
                        ItemsSource="{x:Bind ViewModel.Results}"
                        SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="CornerRadius" Value="14" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:GlanceResultViewModel">
                                <Grid
                                    ColumnSpacing="12"
                                    AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{StaticResource GlazeElevatedBrush}"
                                        CornerRadius="10">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasSubtitle}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource GlazeTextMutedBrush}"
                                        Text="{x:Bind KindLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Margin="14,18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Ничего не найдено"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Popover «Центр управления» (D1): слой поверх сетки, прижат к правому краю
              (под правым pill). Отдельный слой нужен потому, что колонка статуса имеет
              ширину Auto: широкий дочерний элемент растянул бы сам pill.  -->
        <Border
            x:Name="QuickSettingsPanel"
            Width="380"
            Margin="0,56,0,0"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource GlazeGlassBrush}"
            CornerRadius="32"
            Visibility="{x:Bind ViewModel.QuickSettings.IsOpen, Mode=OneWay}">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                    Text="Центр управления" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="ЗВУК" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.Name="Выключить звук"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnToggleMute"
                            CornerRadius="20"
                            IsEnabled="{x:Bind ViewModel.QuickSettings.IsVolumeAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="Выключить звук">
                            <FontIcon
                                FontSize="15"
                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                Glyph="{x:Bind ViewModel.QuickSettings.VolumeGlyph, Mode=OneWay}" />
                        </Button>

                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Громкость"
                            IsEnabled="{x:Bind ViewModel.QuickSettings.IsVolumeAvailable, Mode=OneWay}"
                            Maximum="100"
                            Minimum="0"
                            Value="{x:Bind ViewModel.QuickSettings.VolumePercent, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Column="2"
                            Width="64"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.QuickSettings.VolumeLabel, Mode=OneWay}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Устройство вывода не найдено"
                        Visibility="{x:Bind ViewModel.QuickSettings.HasNoVolume, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="ОФОРМЛЕНИЕ" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Тема оформления Glaze Shell"
                        ItemsSource="{x:Bind ViewModel.QuickSettings.ThemeModeOptions}"
                        SelectedItem="{x:Bind ViewModel.QuickSettings.SelectedThemeMode, Mode=TwoWay}"
                        ToolTipService.ToolTip="Тема оформления Glaze Shell">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="presentation:ThemeModeOption">
                                <TextBlock Text="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="СИСТЕМА" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenNetworkSettings"
                            Content="Сеть"
                            CornerRadius="16" />
                        <Button
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenBluetoothSettings"
                            Content="Bluetooth"
                            CornerRadius="16" />
                        <Button
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Click="OnOpenSoundSettings"
                            Content="Звук"
                            CornerRadius="16" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Popover часов и календаря (D4): тот же слой, что и «Центр управления», и та же
              геометрия (ширина 380, радиус 32, отступ 56 сверху). Открывается кликом по
              часам в правом pill; поиск и «Центр управления» при этом закрываются.  -->
        <Border
            x:Name="CalendarPanel"
            Width="380"
            Margin="0,56,0,0"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource GlazeGlassBrush}"
            CornerRadius="32"
            Visibility="{x:Bind ViewModel.Calendar.IsOpen, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.Calendar.MonthTitle, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource GlazeTextMutedBrush}"
                            Text="{x:Bind ViewModel.Calendar.TodayLabel, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Предыдущий месяц"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnCalendarPreviousMonth"
                            CornerRadius="16"
                            ToolTipService.ToolTip="Предыдущий месяц">
                            <FontIcon FontSize="12" Foreground="{StaticResource GlazeTextPrimaryBrush}" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            Height="32"
                            Padding="10,0"
                            AutomationProperties.Name="Показать сегодняшний месяц"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnCalendarToday"
                            Content="Сегодня"
                            CornerRadius="16"
                            IsEnabled="{x:Bind ViewModel.Calendar.CanGoToToday, Mode=OneWay}"
                            ToolTipService.ToolTip="Показать сегодняшний месяц" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Следующий месяц"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnCalendarNextMonth"
                            CornerRadius="16"
                            ToolTipService.ToolTip="Следующий месяц">
                            <FontIcon FontSize="12" Foreground="{StaticResource GlazeTextPrimaryBrush}" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Calendar.WeekdayLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Width="40"
                                Margin="2,0"
                                FontSize="11"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="{Binding}"
                                TextAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Calendar.Weeks, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:CalendarWeekViewModel">
                            <ItemsControl ItemsSource="{x:Bind Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:CalendarDayViewModel">
                                        <Grid
                                            Width="40"
                                            Height="40"
                                            Margin="2"
                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                            <Border Background="Transparent" CornerRadius="20" />
                                            <Border
                                                BorderBrush="{StaticResource GlazeAccentBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="20"
                                                Visibility="{x:Bind IsToday}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                Opacity="{x:Bind Opacity}"
                                                Text="{x:Bind DayText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
