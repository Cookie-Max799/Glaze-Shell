<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.TopBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Окно верхней панели (A6). Фон прозрачный: стекло рисует системный acrylic-backdrop,
        а плитки лежат поверх него. Содержимое — три «pill»: приложение, поиск, статус+часы.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Левая плитка: активное приложение и расположение.  -->
            <Border
                Grid.Column="0"
                Padding="14,0"
                Background="{StaticResource GlazeSurfaceBrush}"
                BorderBrush="{StaticResource GlazeBorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <Border
                        Width="30"
                        Height="30"
                        Background="{StaticResource GlazeAccentBrush}"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind ViewModel.AppInitial, Mode=OneWay}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            MaxWidth="220"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            MaxWidth="220"
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.AppLocation, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind ViewModel.HasLocation, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Центральная плитка: строка поиска.  -->
            <Border
                Grid.Column="1"
                Width="440"
                Padding="14,0"
                HorizontalAlignment="Center"
                Background="{StaticResource GlazeElevatedBrush}"
                BorderBrush="{StaticResource GlazeBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                PointerPressed="OnSearchPointerPressed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Glyph="&#xE721;" />

                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Padding="0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        PlaceholderText="Поиск приложений, файлов, настроек…"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

                    <Border
                        Grid.Column="2"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        Background="{StaticResource GlazeSurfaceBrush}"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextMutedBrush}"
                            Text="Ctrl K" />
                    </Border>
                </Grid>
            </Border>

            <!--  Правая плитка: статус и часы.  -->
            <Border
                Grid.Column="2"
                Padding="16,0"
                Background="{StaticResource GlazeSurfaceBrush}"
                BorderBrush="{StaticResource GlazeBorderBrush}"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="14"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontSize="15"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Glyph="{x:Bind ViewModel.NetworkGlyph, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NetworkText, Mode=OneWay}" />
                    <FontIcon
                        FontSize="15"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Glyph="&#xE767;"
                        ToolTipService.ToolTip="Громкость" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4"
                        ToolTipService.ToolTip="Питание">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="15"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" />
                    </StackPanel>

                    <Rectangle
                        Width="1"
                        Height="22"
                        Fill="{StaticResource GlazeBorderBrush}" />

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.ClockTime, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.ClockDate, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
