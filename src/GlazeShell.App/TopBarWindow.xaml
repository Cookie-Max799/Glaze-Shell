<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.TopBarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:presentation="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <!--
        Окно верхней панели (A6). Стекло рисует системный acrylic-backdrop. Окно занимает
        всю ширину экрана: видна полоса сверху с нижним скруглением, которая в покое лишь
        чуть выезжает из-за верхнего края, а при наведении раскрывается полностью.
        Панель результатов Glance и popover живут в этом же окне.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- Полноширинная стеклянная полоса с нижним скруглением -->
        <Border
            x:Name="BarBackground"
            Height="30"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="{StaticResource GlazeGlassBrush}"
            BorderThickness="0"
            IsHitTestVisible="False" />

        <Grid x:Name="Layout" Margin="12,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Левая плитка пустая для баланса.  -->
            <Border
                x:Name="AppPill"
                Grid.Row="0"
                Grid.Column="0"
                Width="1"
                IsHitTestVisible="False" />

            <!--  Центральная плитка: поиск.  -->
            <Grid
                x:Name="SearchHit"
                Grid.Row="0"
                Grid.Column="1"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                AutomationProperties.Name="Поиск"
                IsTabStop="True"
                PointerPressed="OnSearchPointerPressed"
                Tapped="OnSearchPointerPressed">
                <Border
                    x:Name="SearchPill"
                    Width="28"
                    Height="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource GlazeElevatedBrush}"
                    CornerRadius="14"
                    IsHitTestVisible="False">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Glyph="&#xE721;" />
                </Border>
            </Grid>

            <Popup
                x:Name="SearchTextPopup"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsOpen="False"
                IsLightDismissEnabled="True"
                Closed="OnSearchPopupClosed">
                <Border
                    Width="320"
                    Margin="0,34,0,0"
                    Padding="10,6"
                    Background="{StaticResource GlazeGlassBrush}"
                    CornerRadius="16">
                    <TextBox
                        x:Name="PopupSearchBox"
                        Padding="0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="12"
                        KeyDown="OnSearchKeyDown"
                        PlaceholderText="Поиск приложений, файлов, настроек…"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                </Border>
            </Popup>

            <!--  Правая плитка: статус и часы.  -->
            <Border
                x:Name="StatusPill"
                Grid.Row="0"
                Grid.Column="2"
                Padding="12,0"
                Margin="0,4"
                AutomationProperties.Name="Центр управления"
                Background="{StaticResource GlazeElevatedBrush}"
                CornerRadius="18"
                IsTabStop="True"
                KeyDown="OnStatusKeyDown"
                PointerPressed="OnStatusPointerPressed">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        MaxWidth="260"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GlazeTextPrimaryBrush}"
                        Text="{x:Bind ViewModel.AppName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.CpuText, Mode=OneWay}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="3"
                        AutomationProperties.Name="Питание"
                        ToolTipService.ToolTip="Питание">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.BatteryGlyph, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.BatteryText, Mode=OneWay}" />
                    </StackPanel>

                    <Rectangle
                        Width="1"
                        Height="16"
                        Fill="{StaticResource GlazeBorderBrush}" />

                    <Button
                        x:Name="ClockButton"
                        Height="24"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Дата и время — открыть календарь"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnClockClick"
                        CornerRadius="8"
                        HorizontalContentAlignment="Right"
                        ToolTipService.ToolTip="Календарь">
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6"
                            AutomationProperties.Name="Дата и время">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                Text="{x:Bind ViewModel.ClockTime, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ClockDate, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Панель результатов Glance (B1) под строкой поиска: та же колонка, что и поиск.  -->
            <Border
                x:Name="ResultsPanel"
                Grid.Row="1"
                Grid.Column="1"
                Width="340"
                Margin="0,8,0,0"
                Padding="6"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{StaticResource GlazeGlassBrush}"
                BorderThickness="0"
                CornerRadius="16"
                Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay}">
                <Grid>
                    <ListView
                        x:Name="ResultsList"
                        MaxHeight="336"
                        Background="Transparent"
                        IsItemClickEnabled="True"
                        ItemClick="OnResultClicked"
                        ItemsSource="{x:Bind ViewModel.Results}"
                        SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="CornerRadius" Value="14" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="presentation:GlanceResultViewModel">
                                <Grid
                                    ColumnSpacing="12"
                                    AutomationProperties.Name="{x:Bind Title}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="32"
                                        Height="32"
                                        Background="{StaticResource GlazeElevatedBrush}"
                                        CornerRadius="10">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                            Glyph="{x:Bind Glyph}" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11.5"
                                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                            Text="{x:Bind Subtitle}"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasSubtitle}" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{StaticResource GlazeTextMutedBrush}"
                                        Text="{x:Bind KindLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Margin="14,18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Ничего не найдено"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
                </Grid>
            </Border>
        </Grid>

        <!--  Popover «Центр управления» (D1): слой поверх сетки, прижат к правому краю
              (под правым pill). Отдельный слой нужен потому, что колонка статуса имеет
              ширину Auto: широкий дочерний элемент растянул бы сам pill.  -->
        <Border
            x:Name="QuickSettingsPanel"
            Width="380"
            Margin="0,56,0,0"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource GlazeGlassBrush}"
            CornerRadius="32"
            Visibility="{x:Bind ViewModel.QuickSettings.IsOpen, Mode=OneWay}">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                    Text="Центр управления" />

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="ЗВУК" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Padding="0"
                            AutomationProperties.Name="Выключить звук"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnToggleMute"
                            CornerRadius="20"
                            IsEnabled="{x:Bind ViewModel.QuickSettings.IsVolumeAvailable, Mode=OneWay}"
                            ToolTipService.ToolTip="Выключить звук">
                            <FontIcon
                                FontSize="15"
                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                Glyph="{x:Bind ViewModel.QuickSettings.VolumeGlyph, Mode=OneWay}" />
                        </Button>

                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Громкость"
                            IsEnabled="{x:Bind ViewModel.QuickSettings.IsVolumeAvailable, Mode=OneWay}"
                            Maximum="100"
                            Minimum="0"
                            Value="{x:Bind ViewModel.QuickSettings.VolumePercent, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Column="2"
                            Width="64"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="{x:Bind ViewModel.QuickSettings.VolumeLabel, Mode=OneWay}"
                            TextAlignment="Right" />
                    </Grid>

                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Устройство вывода не найдено"
                        Visibility="{x:Bind ViewModel.QuickSettings.HasNoVolume, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="ОФОРМЛЕНИЕ" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Тема оформления Glaze Shell"
                        ItemsSource="{x:Bind ViewModel.QuickSettings.ThemeModeOptions}"
                        SelectedItem="{x:Bind ViewModel.QuickSettings.SelectedThemeMode, Mode=TwoWay}"
                        ToolTipService.ToolTip="Тема оформления Glaze Shell">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="presentation:ThemeModeOption">
                                <TextBlock Text="{x:Bind Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="11.5"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="СИСТЕМА" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Stretch">
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OnOpenNetworkSettings"
                            Content="Сеть"
                            CornerRadius="16" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OnOpenBluetoothSettings"
                            Content="Bluetooth"
                            CornerRadius="16" />
                        <Button
                            HorizontalAlignment="Stretch"
                            Click="OnOpenSoundSettings"
                            Content="Звук"
                            CornerRadius="16" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!--  Popover часов и календаря (D4): тот же слой, что и «Центр управления», и та же
              геометрия (ширина 380, радиус 32, отступ 56 сверху). Открывается кликом по
              часам в правом pill; поиск и «Центр управления» при этом закрываются.  -->
        <Border
            x:Name="CalendarPanel"
            Width="380"
            Margin="0,56,0,0"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{StaticResource GlazeGlassBrush}"
            CornerRadius="32"
            Visibility="{x:Bind ViewModel.Calendar.IsOpen, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.Calendar.MonthTitle, Mode=OneWay}" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{StaticResource GlazeTextMutedBrush}"
                            Text="{x:Bind ViewModel.Calendar.TodayLabel, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Предыдущий месяц"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnCalendarPreviousMonth"
                            CornerRadius="16"
                            ToolTipService.ToolTip="Предыдущий месяц">
                            <FontIcon FontSize="12" Foreground="{StaticResource GlazeTextPrimaryBrush}" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            Height="32"
                            Padding="10,0"
                            AutomationProperties.Name="Показать сегодняшний месяц"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnCalendarToday"
                            Content="Сегодня"
                            CornerRadius="16"
                            IsEnabled="{x:Bind ViewModel.Calendar.CanGoToToday, Mode=OneWay}"
                            ToolTipService.ToolTip="Показать сегодняшний месяц" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="0"
                            AutomationProperties.Name="Следующий месяц"
                            Background="{StaticResource GlazeElevatedBrush}"
                            BorderThickness="0"
                            Click="OnCalendarNextMonth"
                            CornerRadius="16"
                            ToolTipService.ToolTip="Следующий месяц">
                            <FontIcon FontSize="12" Foreground="{StaticResource GlazeTextPrimaryBrush}" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Calendar.WeekdayLabels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Width="40"
                                Margin="2,0"
                                FontSize="11"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="{Binding}"
                                TextAlignment="Center" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl
                    HorizontalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Calendar.Weeks, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="presentation:CalendarWeekViewModel">
                            <ItemsControl ItemsSource="{x:Bind Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="presentation:CalendarDayViewModel">
                                        <Grid
                                            Width="40"
                                            Height="40"
                                            Margin="2"
                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                            <Border Background="Transparent" CornerRadius="20" />
                                            <Border
                                                BorderBrush="{StaticResource GlazeAccentBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="20"
                                                Visibility="{x:Bind IsToday}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                Opacity="{x:Bind Opacity}"
                                                Text="{x:Bind DayText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
