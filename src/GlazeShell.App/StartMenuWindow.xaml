<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Меню «Пуск»: панель, выезжающая из левого края экрана. Открывается одиночным
        нажатием клавиши Windows, повторное нажатие, Esc или потеря фокуса скрывают её.
    -->
    <Grid x:Name="Root" KeyDown="OnKeyDown">
        <Border
            x:Name="Panel"
            Background="{StaticResource GlazeSurfaceBrush}"
            BorderBrush="{StaticResource GlazeBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="28,26,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Заголовок: знак Glaze Shell и подпись.  -->
                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,0,0,24">
                    <Border
                        Width="38"
                        Height="38"
                        CornerRadius="12"
                        Background="{StaticResource GlazeBrandGradientBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeWhiteBrush}"
                            Text="G" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            Text="Glaze Shell" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource GlazeTextMutedBrush}"
                            Text="Меню приложений" />
                    </StackPanel>
                </StackPanel>

                <!--  Поиск: рамка с иконкой и полем без собственной рамки.  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,22"
                    Padding="12,4,12,4"
                    CornerRadius="12"
                    Background="{StaticResource GlazeGlassBrush}"
                    BorderBrush="{StaticResource GlazeBorderBrush}"
                    BorderThickness="1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource GlazeTextMutedBrush}"
                            Glyph="&#xE721;" />
                        <TextBox
                            Grid.Column="1"
                            x:Name="SearchBox"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            IsSpellCheckEnabled="False"
                            PlaceholderText="Поиск приложений"
                            TextChanged="OnSearchTextChanged" />
                    </Grid>
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Margin="4,0,0,10"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GlazeTextMutedBrush}"
                    Text="ПРИЛОЖЕНИЯ" />

                <Grid Grid.Row="3">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <GridView
                            x:Name="AppsGrid"
                            Padding="0,0,4,8"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnAppItemClick">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Width="108"
                                        Padding="6,8,6,8"
                                        Spacing="8">
                                        <Border
                                            Width="46"
                                            Height="46"
                                            CornerRadius="14"
                                            Background="{StaticResource GlazeGlassBrush}"
                                            BorderBrush="{StaticResource GlazeBorderBrush}"
                                            BorderThickness="1">
                                            <Image
                                                Width="26"
                                                Height="26"
                                                Source="{Binding Icon}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <TextBlock
                                            FontSize="11"
                                            MaxLines="2"
                                            Text="{Binding Name}"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </ScrollViewer>

                    <TextBlock
                        x:Name="EmptyText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,24,0,0"
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Ничего не найдено"
                        Visibility="Collapsed" />
                </Grid>

                <!--  Нижний ряд: настройки и проводник.  -->
                <Grid
                    Grid.Row="4"
                    Margin="0,16,0,0"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE713;" />
                            <TextBlock FontSize="12" Text="Параметры" />
                        </StackPanel>
                    </Button>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnExplorerClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                            <TextBlock FontSize="12" Text="Проводник" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
