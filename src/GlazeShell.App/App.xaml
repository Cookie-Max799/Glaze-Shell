<Application
    x:Class="GlazeShell.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Палитра взята из логотипа Glaze Shell: почти чёрная подложка, светлый текст
                и индиго-фиолетовый акцент (градиент #5F7CFF → #8E8CFF → #8B6CF9).
            -->
            <Color x:Key="GlazeBackgroundColor">#131316</Color>
            <Color x:Key="GlazeSurfaceColor">#1C1C1E</Color>
            <Color x:Key="GlazeRaisedColor">#232326</Color>
            <Color x:Key="GlazeTextPrimaryColor">#F5F5F7</Color>
            <Color x:Key="GlazeTextSecondaryColor">#A1A1AA</Color>
            <Color x:Key="GlazeTextMutedColor">#6E6E76</Color>
            <Color x:Key="GlazeAccentColor">#8E8CFF</Color>

            <!--
                Стандартная подсветка выбранного элемента списка почти незаметна на тёмном
                фоне. Кисти заданы прямо в корневом словаре: он ищется раньше влитых
                XamlControlsResources, поэтому перекрывает значения темы.
            -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#26262B" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#2C2C33" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#33314A" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#3B3860" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#423F6B" />

            <Style x:Key="ApplicationCardStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
