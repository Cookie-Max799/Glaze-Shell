<Application
    x:Class="GlazeShell.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Токены оформления Glaze Shell. Значения — тёмная палитра по умолчанию;
                ThemeApplicator перекрашивает эти же кисти при старте и при смене темы,
                поэтому элементы обновляются без перезагрузки XAML. Источник значений —
                docs/DESIGN.md и docs/design/tokens/tokens.json.
            -->
            <SolidColorBrush x:Key="GlazeBackgroundBrush" Color="#14122B" />
            <SolidColorBrush x:Key="GlazeSurfaceBrush" Color="#1E1B3D" />
            <SolidColorBrush x:Key="GlazeElevatedBrush" Color="#2A2754" />
            <SolidColorBrush x:Key="GlazeBorderBrush" Color="#3A3670" />
            <SolidColorBrush x:Key="GlazeGlassBrush" Color="#44221E4A" />
            <SolidColorBrush x:Key="GlazeBlackBrush" Color="#000000" />
            <SolidColorBrush x:Key="GlazeWhiteBrush" Color="#FFFFFF" />

            <!--  Бренд-градиент (Sky → Cobalt → Orchid): логотип, активные индикаторы.  -->
            <LinearGradientBrush x:Key="GlazeBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#64D2FF" />
                <GradientStop Offset="0.5" Color="#5E7BFF" />
                <GradientStop Offset="1" Color="#BF5AF2" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlazeTextPrimaryBrush" Color="#F4F1FF" />
            <SolidColorBrush x:Key="GlazeTextSecondaryBrush" Color="#B2AED8" />
            <SolidColorBrush x:Key="GlazeTextMutedBrush" Color="#7773A8" />
            <SolidColorBrush x:Key="GlazeAccentBrush" Color="#A99BFF" />
            <SolidColorBrush x:Key="GlazeSelectionBrush" Color="#33A99BFF" />
            <SolidColorBrush x:Key="GlazeStatusSuccessBrush" Color="#3FCF9B" />
            <SolidColorBrush x:Key="GlazeStatusCriticalBrush" Color="#FF6B81" />

            <!--
                Стандартная подсветка выбранного элемента списка почти незаметна на тёмном
                фоне. Кисти заданы прямо в корневом словаре: он ищется раньше влитых
                XamlControlsResources, поэтому перекрывает значения темы.
            -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#2A2754" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#2A2754" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#33A99BFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33A99BFF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33A99BFF" />

            <!--
                Фокус-ринг (доступность, I5). Встроенный фокус-визуал WinUI рисует заливку
                первым цветом и обводку вторым, поэтому прозрачная заливка и акцентная обводка
                дают требуемый DESIGN §7 ринг — 2 px акцентом с отступом. ThemeApplicator
                перекрашивает оба цвета при смене темы и в режиме высокой контрастности.
            -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#00A99BFF" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#A99BFF" />

            <Style x:Key="ApplicationCardStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="{StaticResource GlazeSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
