<Application
    x:Class="GlazeShell.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:p="using:GlazeShell.App.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Токены оформления Glaze Shell. Значения — тёмная палитра по умолчанию;
                ThemeApplicator перекрашивает эти же кисти при старте и при смене темы,
                поэтому элементы обновляются без перезагрузки XAML. Источник значений —
                docs/DESIGN.md и docs/design/tokens/tokens.json.
            -->
            <SolidColorBrush x:Key="GlazeBackgroundBrush" Color="#0E0B22" />
            <SolidColorBrush x:Key="GlazeSurfaceBrush" Color="#171332" />
            <SolidColorBrush x:Key="GlazeElevatedBrush" Color="#221C48" />
            <SolidColorBrush x:Key="GlazeBorderBrush" Color="#40B4A4FF" />
            <!--
                Стекло всплывающих панелей верхней полосы. Верхний стоп совпадает с
                плотностью полосы, нижний — с прозрачностью панели (не выше 70 %):
                так на границе нет резкого перехода, панель «переливается» в полосу.
                Оба стопа перекрашивает ThemeApplicator.
            -->
            <LinearGradientBrush
                x:Key="GlazeGlassBrush"
                MappingMode="Absolute"
                StartPoint="0.5,0"
                EndPoint="0.5,48">
                <GradientStop Offset="0" Color="#1A211B45" />
                <GradientStop Offset="1" Color="#4D211B45" />
            </LinearGradientBrush>
            <!--  Стекло панелей: у верхней панели и dock свои ползунки прозрачности.  -->
            <SolidColorBrush x:Key="GlazeTopBarGlassBrush" Color="#8C211B45" />
            <SolidColorBrush x:Key="GlazeDockGlassBrush" Color="#8C211B45" />
            <!--  Плашки верхней панели: следуют её прозрачности и растворяются в полосе.  -->
            <SolidColorBrush x:Key="GlazeTopBarPillBrush" Color="#33221C48" />
            <SolidColorBrush x:Key="GlazeBlackBrush" Color="#000000" />
            <SolidColorBrush x:Key="GlazeWhiteBrush" Color="#FFFFFF" />

            <!--  Бренд-градиент (Sky → Cobalt → Orchid): логотип, активные индикаторы.  -->
            <LinearGradientBrush x:Key="GlazeBrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#64D2FF" />
                <GradientStop Offset="0.5" Color="#5E7BFF" />
                <GradientStop Offset="1" Color="#BF5AF2" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="GlazeTextPrimaryBrush" Color="#F8F4FF" />
            <SolidColorBrush x:Key="GlazeTextSecondaryBrush" Color="#C6C0EC" />
            <SolidColorBrush x:Key="GlazeTextMutedBrush" Color="#918BBB" />
            <SolidColorBrush x:Key="GlazeAccentBrush" Color="#C9BEFF" />
            <SolidColorBrush x:Key="GlazeSelectionBrush" Color="#33B4A4FF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />

            <!--
                Акцентные кисти стандартных элементов: ползунок, переключатель, флажок и
                подсветка списков берут цвет отсюда, поэтому смена акцента видна не только
                в собственных кистях Glaze Shell. ThemeApplicator перекрашивает их.
            -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B4A4FF" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#C9BEFF" />
            <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#B4A4FF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#B4A4FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#B4A4FF" />

            <SolidColorBrush x:Key="GlazeStatusSuccessBrush" Color="#3FCF9B" />
            <SolidColorBrush x:Key="GlazeStatusCriticalBrush" Color="#FF6B81" />

            <!--
                Стандартная подсветка выбранного элемента списка почти незаметна на тёмном
                фоне. Кисти заданы прямо в корневом словаре: он ищется раньше влитых
                XamlControlsResources, поэтому перекрывает значения темы.
            -->
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#221C48" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#221C48" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#33B4A4FF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33B4A4FF" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#33B4A4FF" />

            <!--
                Состояние «включено» у ToggleButton по умолчанию заливается системным
                акцентом (AccentFillColorDefaultBrush). Он приходит из системных ресурсов
                Windows, поэтому не перекрашивается темой Glaze Shell: на проверке кнопка
                панели мониторов рисовалась светло-серой #D8D8D8 при любом акценте.
                Здесь состояние привязано к собственным кистям, и оно следует за темой.
            -->
            <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="GlazeSelectionBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="GlazeSelectionBrush" />
            <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="GlazeSelectionBrush" />
            <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="GlazeAccentBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="GlazeAccentBrush" />
            <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="GlazeAccentBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="GlazeBorderBrush" />
            <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="GlazeBorderBrush" />

            <!--
                Единый радиус скруглений (DESIGN §6). ControlCornerRadius задаёт поля,
                кнопки и списки, OverlayCornerRadius — меню, подсказки и диалоги, поэтому
                системные элементы перестают выбиваться из собственных поверхностей
                Glaze Shell радиусами 4. Список и плитка получают свои значения.
            -->
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ListViewItemCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="GridViewItemCornerRadius">12</CornerRadius>

            <!--
                Фокус-ринг (доступность, I5). Встроенный фокус-визуал WinUI рисует заливку
                первым цветом и обводку вторым, поэтому прозрачная заливка и акцентная обводка
                дают требуемый DESIGN §7 ринг — 2 px акцентом с отступом. ThemeApplicator
                перекрашивает оба цвета при смене темы и в режиме высокой контрастности.
            -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="#00B4A4FF" />
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="#C9BEFF" />

            <p:HexToBrushConverter x:Key="HexToBrushConverter" />

            <!--
                Компактные кнопки панелей: прозрачный фон сливается с поверхностью шапки,
                а радиус 8 совпадает с радиусом плашек, поэтому ряд кнопок выглядит ровным.
                Иконочные варианты используются там, где подпись заменяет подсказка.
            -->
            <Style x:Key="GlazeToolbarButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style
                x:Key="GlazeIconButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource GlazeToolbarButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style
                x:Key="GlazeSmallIconButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource GlazeIconButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>

            <Style x:Key="ApplicationCardStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="{StaticResource GlazeSurfaceBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
