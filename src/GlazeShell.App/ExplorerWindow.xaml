<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.ExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="{StaticResource GlazeBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Панель: навигация, заголовок, сортировка и вид списка.  -->
        <Border
            Grid.Row="0"
            Padding="14,12"
            Background="{StaticResource GlazeSurfaceBrush}"
            BorderBrush="{StaticResource GlazeBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <Button
                        AutomationProperties.Name="Назад"
                        Click="OnBackClick"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        ToolTipService.ToolTip="Назад">
                        <FontIcon FontSize="15" Glyph="&#xE72B;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Вперёд"
                        Click="OnForwardClick"
                        IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                        ToolTipService.ToolTip="Вперёд">
                        <FontIcon FontSize="15" Glyph="&#xE72A;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="На уровень выше"
                        Click="OnUpClick"
                        IsEnabled="{x:Bind ViewModel.CanGoUp, Mode=OneWay}"
                        ToolTipService.ToolTip="На уровень выше">
                        <FontIcon FontSize="15" Glyph="&#xE74A;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Обновить"
                        Click="OnRefreshClick"
                        ToolTipService.ToolTip="Обновить">
                        <FontIcon FontSize="15" Glyph="&#xE72C;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Добавить текущую папку в избранное"
                        Click="OnAddFavoriteClick"
                        ToolTipService.ToolTip="Добавить текущую папку в избранное">
                        <FontIcon FontSize="15" Glyph="&#xE840;" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Предпросмотр выбранного элемента"
                        Click="OnPreviewClick"
                        ToolTipService.ToolTip="Предпросмотр выбранного элемента (пробел)">
                        <FontIcon FontSize="15" Glyph="&#xE8FF;" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GlazeTextPrimaryBrush}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="{x:Bind ViewModel.Breadcrumb, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <ComboBox
                        MinWidth="132"
                        AutomationProperties.Name="Сортировка"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.SortOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedSort, Mode=TwoWay}"
                        ToolTipService.ToolTip="Сортировка" />
                    <Button
                        AutomationProperties.Name="Направление сортировки"
                        Click="OnSortDirectionClick"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SortToolTip, Mode=OneWay}">
                        <FontIcon FontSize="15" Glyph="{x:Bind ViewModel.SortGlyph, Mode=OneWay}" />
                    </Button>
                    <ComboBox
                        MinWidth="132"
                        AutomationProperties.Name="Вид списка"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.ViewOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedView, Mode=TwoWay}"
                        ToolTipService.ToolTip="Вид списка" />
                    <ProgressRing
                        Width="18"
                        Height="18"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Сайдбар (E2): избранное и диски.  -->
            <Border
                Grid.Column="0"
                Background="{StaticResource GlazeSurfaceBrush}"
                BorderBrush="{StaticResource GlazeBorderBrush}"
                BorderThickness="0,0,1,0">
                <ScrollViewer Padding="10,14">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="8,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Избранное" />
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="OnSidebarItemClick"
                                ItemsSource="{x:Bind ViewModel.Favorites}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="p:ExplorerSidebarItemViewModel">
                                        <Grid
                                            ColumnSpacing="8"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            ToolTipService.ToolTip="{x:Bind ToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                                Glyph="{x:Bind Glyph}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="2"
                                                Width="26"
                                                Height="26"
                                                Padding="0"
                                                AutomationProperties.Name="Убрать из избранного"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnRemoveFavoriteClick"
                                                ToolTipService.ToolTip="Убрать из избранного"
                                                Visibility="{x:Bind IsFavorite}">
                                                <FontIcon FontSize="11" Glyph="&#xE711;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock
                                Margin="8,0,0,4"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Диски" />
                            <ListView
                                IsItemClickEnabled="True"
                                ItemClick="OnSidebarItemClick"
                                ItemsSource="{x:Bind ViewModel.Drives}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="p:ExplorerSidebarItemViewModel">
                                        <StackPanel
                                            Spacing="4"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            ToolTipService.ToolTip="{x:Bind ToolTip}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon
                                                    FontSize="15"
                                                    Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                                    Glyph="{x:Bind Glyph}" />
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <ProgressBar
                                                Height="3"
                                                Maximum="100"
                                                Visibility="{x:Bind ShowUsage}"
                                                Value="{x:Bind UsagePercent}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  Содержимое папки: сетка иконок (E1) или список с колонками (E1).  -->
            <Grid Grid.Column="1">
                <GridView
                    x:Name="IconView"
                    Padding="14"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    ItemsSource="{x:Bind ViewModel.Items}"
                    KeyDown="OnItemsKeyDown"
                    SelectionMode="Single"
                    Visibility="{x:Bind ViewModel.IconsVisibility, Mode=OneWay}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="p:ExplorerItemViewModel">
                            <StackPanel
                                Width="104"
                                Padding="4"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                Background="Transparent"
                                Spacing="6"
                                ToolTipService.ToolTip="{x:Bind ToolTip}">
                                <Grid Height="52" HorizontalAlignment="Center">
                                    <FontIcon
                                        FontSize="40"
                                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                        Glyph="{x:Bind Glyph}"
                                        Visibility="{x:Bind ShowGlyph, Mode=OneWay}" />
                                    <Image
                                        Width="48"
                                        Height="48"
                                        Source="{x:Bind Icon, Mode=OneWay}"
                                        Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                    MaxLines="2"
                                    Text="{x:Bind Name}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <Grid Visibility="{x:Bind ViewModel.ListVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Padding="14,10"
                        BorderBrush="{StaticResource GlazeBorderBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="12"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Имя" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Тип" />
                            <TextBlock
                                Grid.Column="2"
                                FontSize="12"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Размер" />
                            <TextBlock
                                Grid.Column="3"
                                FontSize="12"
                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                Text="Изменён" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="ItemsList"
                        Grid.Row="1"
                        Padding="0,6"
                        IsItemClickEnabled="True"
                        ItemClick="OnItemClick"
                        ItemsSource="{x:Bind ViewModel.Items}"
                        KeyDown="OnItemsKeyDown"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:ExplorerItemViewModel">
                                <Grid
                                    Background="Transparent"
                                    ColumnSpacing="8"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontSize="15"
                                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                            Glyph="{x:Bind Glyph}"
                                            Visibility="{x:Bind ShowGlyph, Mode=OneWay}" />
                                        <Image
                                            Width="16"
                                            Height="16"
                                            Source="{x:Bind Icon, Mode=OneWay}"
                                            Visibility="{x:Bind HasIcon, Mode=OneWay}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                        Text="{x:Bind KindLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                        Text="{x:Bind SizeLabel}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                        Text="{x:Bind ModifiedLabel}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource GlazeTextMutedBrush}"
                    Text="Папка пуста"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="14,8"
            Background="{StaticResource GlazeSurfaceBrush}"
            BorderBrush="{StaticResource GlazeBorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource GlazeTextMutedBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>
