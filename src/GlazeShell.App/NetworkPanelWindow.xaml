<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.NetworkPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" Padding="20" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            FontSize="18"
            FontWeight="SemiBold"
            Foreground="{StaticResource GlazeTextPrimaryBrush}"
            Text="Wi-Fi" />

        <StackPanel Grid.Row="1" Spacing="3" Margin="0,0,0,14">
            <TextBlock
                x:Name="StatusText"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="{StaticResource GlazeTextPrimaryBrush}" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="11"
                Foreground="{StaticResource GlazeTextMutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NetworksList" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12,10"
                                Margin="0,0,0,6"
                                Background="{StaticResource GlazeGlassBrush}"
                                BorderBrush="{StaticResource GlazeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{StaticResource GlazeTextMutedBrush}"
                                        Text="{Binding Status}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock
                x:Name="EmptyText"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="12"
                Foreground="{StaticResource GlazeTextMutedBrush}"
                Text="Сети не найдены"
                Visibility="Collapsed" />
        </Grid>

        <Button
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Click="OnOpenSettings">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
                <TextBlock FontSize="12" Text="Параметры сети" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
