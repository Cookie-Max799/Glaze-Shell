<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <!--
        Окно dock (A1). Стекло рисует системный acrylic-backdrop, но окно имеет региональную
        маску-капсулу (A1.xaml.cs), поэтому видна только сама плавающая панель. Содержимое —
        лента плиток: «Пуск», закреплённые и запущенные приложения, папка «Загрузки», корзина.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <ItemsControl
            x:Name="Tiles"
            Padding="14,24,14,16"
            VerticalAlignment="Center"
            ItemsSource="{x:Bind ViewModel.Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:DockItemViewModel">
                    <Grid>
                        <!--  Плитка приложения: только значок, без подложки.  -->
                        <Border
                            Width="60"
                            Height="60"
                            Background="Transparent"
                            CornerRadius="18"
                            PointerEntered="OnTilePointerEntered"
                            PointerExited="OnTilePointerExited"
                            RightTapped="OnTileRightTapped"
                            Tapped="OnTileTapped"
                            ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                            Visibility="{x:Bind TileVisibility}">
                            <Grid>
                                <!--  Пастельная подложка: буква-заглушка или глиф системной плитки.  -->
                                <Border
                                    Background="{x:Bind FallbackBrush}"
                                    CornerRadius="18"
                                    Visibility="{x:Bind HasPlate, Mode=OneWay}">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind Initial}"
                                            Visibility="{x:Bind ShowLetter, Mode=OneWay}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="26"
                                            Foreground="White"
                                            Glyph="{x:Bind Glyph}"
                                            Visibility="{x:Bind HasGlyph, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!--  Настоящий значок оболочки Windows.  -->
                                <Image
                                    Width="46"
                                    Height="46"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                                <!--  Индикатор запущенного приложения.  -->
                                <Border
                                    Width="16"
                                    Height="4"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource GlazeBrandGradientBrush}"
                                    CornerRadius="2"
                                    Visibility="{x:Bind HasIndicator, Mode=OneWay}" />
                            </Grid>
                        </Border>

                        <!--  Разделитель секций.  -->
                        <Rectangle
                            Width="2"
                            Height="34"
                            RadiusX="1"
                            RadiusY="1"
                            VerticalAlignment="Center"
                            Fill="{StaticResource GlazeBorderBrush}"
                            Visibility="{x:Bind SeparatorVisibility}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
