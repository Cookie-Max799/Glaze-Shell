<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <!--
        Окно dock (A1). Стекло рисует системный acrylic-backdrop поверх прозрачного окна:
        окно имеет региональную маску со скруглёнными только верхними углами
        (DockWindow.xaml.cs), поэтому панель прижата к нижнему краю экрана и растворяется
        в нём. Содержимое — лента плиток: «Пуск», закреплённые и запущенные приложения,
        папка «Загрузки», корзина. Курсор отслеживается на всём окне: магнификация
        считается по расстоянию до него.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.Resources>
            <!--  Подпись плитки: компактная «pill» над значком, как в dock macOS (DESIGN §7.5).  -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource GlazeElevatedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource GlazeTextPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--
                Фокус-ринг плитки (доступность, I5). Плитка — обычная рамка, а встроенный
                фокус-визуал WinUI получают только элементы управления, поэтому кольцо
                нарисовано вручную: 2 px акцентом, как требует DESIGN §7. Цвет берётся из
                общей кисти фокуса, поэтому в режиме высокой контрастности он системный.
            -->
        </Grid.Resources>

        <!--
            Заливка стекла: сам Acrylic даёт преломление фона, а лёгкая тонированная
            подложка делает панель читаемой как стекло, а не как серый прямоугольник.
            Контур не рисуется — форму задаёт региональная маска окна.
        -->
        <Border
            Background="{StaticResource GlazeGlassBrush}"
            BorderThickness="0"
            CornerRadius="22,22,0,0"
            IsHitTestVisible="False" />

        <ItemsControl
            x:Name="Tiles"
            Padding="28,20,28,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            ItemsSource="{x:Bind ViewModel.Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:DockItemViewModel">
                    <Grid>
                        <!--  Плитка приложения: только значок, без подложки.  -->
                        <Border
                            x:Name="TileBorder"
                            Width="40"
                            Height="40"
                            AutomationProperties.Name="{x:Bind ToolTip, Mode=OneWay}"
                            AutomationProperties.AutomationId="{x:Bind Key}"
                            Background="Transparent"
                            CornerRadius="12"
                            GotFocus="OnTileGotFocus"
                            IsTabStop="True"
                            KeyDown="OnTileKeyDown"
                            LostFocus="OnTileLostFocus"
                            RightTapped="OnTileRightTapped"
                            Tapped="OnTileTapped"
                            ToolTipService.Placement="Top"
                            ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                            Visibility="{x:Bind TileVisibility}">
                            <Grid>
                                <!--  Пастельная подложка: буква-заглушка или глиф системной плитки.  -->
                                <Border
                                    Background="{x:Bind FallbackBrush}"
                                    CornerRadius="12"
                                    Visibility="{x:Bind HasPlate, Mode=OneWay}">
                                    <Grid>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{x:Bind Initial}"
                                            Visibility="{x:Bind ShowLetter, Mode=OneWay}" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            Foreground="White"
                                            Glyph="{x:Bind Glyph}"
                                            Visibility="{x:Bind HasGlyph, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!--  Настоящий значок оболочки Windows.  -->
                                <Image
                                    Width="30"
                                    Height="30"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                                <!--  Индикатор запущенного приложения.  -->
                                <Border
                                    Width="12"
                                    Height="3"
                                    Margin="0,0,0,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Background="{StaticResource GlazeBrandGradientBrush}"
                                    CornerRadius="2"
                                    Visibility="{x:Bind HasIndicator, Mode=OneWay}" />

                                <!--
                                    Кольцо фокуса (доступность, I5). Обычная рамка не получает
                                    встроенный фокус-визуал WinUI, поэтому кольцо рисуется
                                    вручную по событиям фокуса (DockWindow.xaml.cs).
                                -->
                                <Border
                                    x:Name="FocusRing"
                                    Margin="-2"
                                    BorderBrush="{StaticResource FocusVisualSecondaryBrush}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <!--  Разделитель секций: без контура, только мягкая заливка.  -->
                        <Rectangle
                            Width="2"
                            Height="24"
                            RadiusX="1"
                            RadiusY="1"
                            VerticalAlignment="Center"
                            Fill="{StaticResource GlazeElevatedBrush}"
                            Visibility="{x:Bind SeparatorVisibility}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
