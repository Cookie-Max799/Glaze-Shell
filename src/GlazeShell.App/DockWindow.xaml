<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <!--
        Окно dock (A1). Стекло рисует системный acrylic-backdrop, а поверх него — капсула
        «жидкого стекла»: градиентный rim по краю и светлый блик под лентой плиток. Окно
        имеет региональную маску со скруглёнными только верхними углами (DockWindow.xaml.cs),
        поэтому панель прижата к нижнему краю экрана и растворяется в нём. Содержимое —
        лента плиток: «Пуск», закреплённые и запущенные приложения, папка «Загрузки»,
        корзина. Курсор отслеживается на всём окне: магнификация считается по расстоянию.
    -->
    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerExited="OnPointerExited"
        PointerMoved="OnPointerMoved">
        <Grid.Resources>
            <!--  Подпись плитки: компактная «pill» над значком, как в dock macOS (DESIGN §7.5).  -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{StaticResource GlazeElevatedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource GlazeTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource GlazeGlassBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </Grid.Resources>

        <!--  Капсула «жидкого стекла»: заливка, градиентный rim и блик.  -->
        <Border
            x:Name="GlassPlate"
            Background="{StaticResource GlazeGlassBrush}"
            BorderBrush="{StaticResource GlazeGlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="36,36,0,0">
            <Grid>
                <Border
                    Background="{StaticResource GlazeGlassGlossBrush}"
                    CornerRadius="35,35,0,0"
                    IsHitTestVisible="False" />

                <ItemsControl
                    x:Name="Tiles"
                    Padding="14,22,14,12"
                    VerticalAlignment="Center"
                    ItemsSource="{x:Bind ViewModel.Items}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="p:DockItemViewModel">
                            <Grid>
                                <!--  Плитка приложения: только значок, без подложки.  -->
                                <Border
                                    Width="52"
                                    Height="52"
                                    Background="Transparent"
                                    CornerRadius="15"
                                    RightTapped="OnTileRightTapped"
                                    Tapped="OnTileTapped"
                                    ToolTipService.Placement="Top"
                                    ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                                    Visibility="{x:Bind TileVisibility}">
                                    <Grid>
                                        <!--  Пастельная подложка: буква-заглушка или глиф системной плитки.  -->
                                        <Border
                                            Background="{x:Bind FallbackBrush}"
                                            CornerRadius="15"
                                            Visibility="{x:Bind HasPlate, Mode=OneWay}">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{x:Bind Initial}"
                                                    Visibility="{x:Bind ShowLetter, Mode=OneWay}" />
                                                <FontIcon
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="22"
                                                    Foreground="White"
                                                    Glyph="{x:Bind Glyph}"
                                                    Visibility="{x:Bind HasGlyph, Mode=OneWay}" />
                                            </Grid>
                                        </Border>

                                        <!--  Настоящий значок оболочки Windows.  -->
                                        <Image
                                            Width="40"
                                            Height="40"
                                            Source="{x:Bind Icon, Mode=OneWay}"
                                            Stretch="Uniform"
                                            Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                                        <!--  Индикатор запущенного приложения.  -->
                                        <Border
                                            Width="14"
                                            Height="3"
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Bottom"
                                            Background="{StaticResource GlazeBrandGradientBrush}"
                                            CornerRadius="2"
                                            Visibility="{x:Bind HasIndicator, Mode=OneWay}" />
                                    </Grid>
                                </Border>

                                <!--  Разделитель секций.  -->
                                <Rectangle
                                    Width="2"
                                    Height="30"
                                    RadiusX="1"
                                    RadiusY="1"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource GlazeBorderBrush}"
                                    Visibility="{x:Bind SeparatorVisibility}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
