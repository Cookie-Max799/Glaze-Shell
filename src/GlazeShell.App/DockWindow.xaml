<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <!--
        Окно dock (A1, базовый слайс). Фон прозрачный: «стекло» рисует системный
        acrylic-backdrop. Содержимое — горизонтальная лента плиток, разделённая на секции:
        «Пуск», закреплённые приложения и запущенные приложения с индикатором.
    -->
    <Grid x:Name="Root" Background="Transparent">
        <ItemsControl
            x:Name="Tiles"
            Padding="14,16,14,12"
            VerticalAlignment="Center"
            ItemsSource="{x:Bind ViewModel.Items}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="5" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="p:DockItemViewModel">
                    <Grid>
                        <!--  Плитка приложения.  -->
                        <Border
                            Width="60"
                            Height="60"
                            Background="{StaticResource GlazeSurfaceBrush}"
                            BorderBrush="{StaticResource GlazeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            PointerEntered="OnTilePointerEntered"
                            PointerExited="OnTilePointerExited"
                            RightTapped="OnTileRightTapped"
                            Tapped="OnTileTapped"
                            ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}"
                            Visibility="{x:Bind TileVisibility}">
                            <Grid>
                                <!--  Запасной вид: буква на устойчивом пастельном градиенте.  -->
                                <Border
                                    Background="{x:Bind FallbackBrush}"
                                    CornerRadius="14"
                                    Visibility="{x:Bind HasNoIcon, Mode=OneWay}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind Initial}" />
                                </Border>

                                <!--  Настоящий значок оболочки Windows.  -->
                                <Image
                                    Width="36"
                                    Height="36"
                                    Source="{x:Bind Icon, Mode=OneWay}"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind HasIcon, Mode=OneWay}" />

                                <!--  Индикатор запущенного приложения.  -->
                                <Border
                                    Width="16"
                                    Height="4"
                                    Margin="0,0,0,5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    CornerRadius="2"
                                    Visibility="{x:Bind HasIndicator, Mode=OneWay}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0" Color="#5E9BFF" />
                                            <GradientStop Offset="1" Color="#BF5AF2" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Разделитель секций.  -->
                        <Rectangle
                            Width="1"
                            Height="30"
                            VerticalAlignment="Center"
                            Fill="{StaticResource GlazeBorderBrush}"
                            Visibility="{x:Bind SeparatorVisibility}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
