<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    xmlns:core="using:GlazeShell.Core.Settings"
    mc:Ignorable="d">

    <!--
        Окно настроек (I1, базовый слайс): слева сайдбар страниц, справа панель настроек с
        поиском и кнопкой сброса. Содержимое страницы строится по декларативному каталогу
        (GlazeShell.Core.Settings.SettingsCatalog), поэтому добавление настройки не требует
        правок этой разметки.
    -->
    <Grid x:Name="Root" Background="{StaticResource GlazeBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Сайдбар: страницы настроек, сгруппированные по разделам.  -->
        <Border
            Grid.Column="0"
            Padding="12,18"
            Background="{StaticResource GlazeSurfaceBrush}"
            BorderBrush="{StaticResource GlazeBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,0,8,4" Spacing="4">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource GlazeTextPrimaryBrush}"
                        Text="Настройки" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Text="Glaze Shell" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    Background="Transparent"
                    ItemsSource="{x:Bind ViewModel.Pages}"
                    SelectedItem="{x:Bind ViewModel.SelectedPage, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="p:SettingsPageItemViewModel">
                            <StackPanel
                                Padding="4,8"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Text="{x:Bind Title}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  Панель: поиск, заголовок страницы и её настройки.  -->
        <Grid
            Grid.Column="1"
            Padding="28,24,28,20"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <AutoSuggestBox
                PlaceholderText="Поиск настроек"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="26"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                    Text="{x:Bind ViewModel.SelectedPageTitle, Mode=OneWay}" />

                <Button
                    Grid.Column="1"
                    Click="OnResetPageClick"
                    IsEnabled="{x:Bind ViewModel.HasSettings, Mode=OneWay}"
                    ToolTipService.ToolTip="Сбросить настройки этой страницы к значениям по умолчанию">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                        <TextBlock Text="Сбросить страницу" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Settings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:SettingRowViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="18,14"
                                    Background="{StaticResource GlazeElevatedBrush}"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                Text="{x:Bind Title}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12.5"
                                                Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                                Text="{x:Bind Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ToggleValue, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent=""
                                                Visibility="{x:Bind IsToggle}" />

                                            <ComboBox
                                                MinWidth="170"
                                                ItemsSource="{x:Bind Choices}"
                                                SelectedItem="{x:Bind SelectedChoice, Mode=TwoWay}"
                                                Visibility="{x:Bind IsChoice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="core:SettingChoice">
                                                        <TextBlock Text="{x:Bind Title}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <TextBox
                                                MinWidth="170"
                                                Text="{x:Bind TextValue, Mode=TwoWay}"
                                                Visibility="{x:Bind IsText}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    Margin="0,40,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    FontSize="14"
                    Foreground="{StaticResource GlazeTextMutedBrush}"
                    Text="{x:Bind ViewModel.EmptyHint, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
