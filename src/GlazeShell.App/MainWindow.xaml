<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:p="using:GlazeShell.App.Presentation"
    mc:Ignorable="d">

    <Grid x:Name="Root" Background="{StaticResource GlazeBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!--  Левая колонка: шапка, список приложений, подвал.  -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="36,30,36,22"
                Background="{StaticResource GlazeSurfaceBrush}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                            Text="Glaze Shell" />
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource GlazeTextSecondaryBrush}"
                            Text="Запуск установленных приложений: меню «Пуск» и пакеты MSIX."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Spacing="10">
                        <ProgressRing
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource GlazeAccentBrush}"
                            IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox
                                MinWidth="130"
                                ItemsSource="{x:Bind ViewModel.ThemeModeOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedThemeMode, Mode=TwoWay}"
                                ToolTipService.ToolTip="Тема оформления">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="p:ThemeModeOption">
                                        <TextBlock Text="{x:Bind Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox
                                MinWidth="150"
                                ItemsSource="{x:Bind ViewModel.AccentOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedAccent, Mode=TwoWay}"
                                ToolTipService.ToolTip="Акцентный цвет">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="p:AccentOption">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                Width="16"
                                                Height="16"
                                                Background="{x:Bind Preview}"
                                                CornerRadius="8" />
                                            <TextBlock Text="{x:Bind Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Верхняя панель"
                                IsChecked="{x:Bind ViewModel.IsTopBarEnabled, Mode=OneWay}"
                                Click="OnTopBarToggle"
                                ToolTipService.ToolTip="Плавающая верхняя панель (A6)" />
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Dock"
                                IsChecked="{x:Bind ViewModel.IsDockEnabled, Mode=OneWay}"
                                Click="OnDockToggle"
                                ToolTipService.ToolTip="Плавающий dock снизу (A1)" />
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="Вместо панели задач"
                                IsChecked="{x:Bind ViewModel.IsDockReplacesTaskbar, Mode=OneWay}"
                                Click="OnReplaceTaskbarToggle"
                                ToolTipService.ToolTip="Скрывать системную панель задач, пока работает dock" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                Padding="36,18,36,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="SearchBox"
                        PlaceholderText="Поиск по названию, пути или AUMID"
                        QueryIcon="Find"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button
                        Grid.Column="1"
                        MinWidth="120"
                        Click="OnRefreshClick"
                        Content="Обновить"
                        IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView
                        x:Name="ApplicationList"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource ApplicationCardStyle}"
                        ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="p:ApplicationListViewModel">
                                <Grid>
                                    <Grid Padding="20,16" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid
                                            Width="22"
                                            Height="22"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="18"
                                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                                Text="{x:Bind RunningGlyph, Mode=OneWay}"
                                                Visibility="{x:Bind IsNotLaunching, Mode=OneWay}" />
                                            <ProgressRing
                                                Width="20"
                                                Height="20"
                                                Foreground="{StaticResource GlazeAccentBrush}"
                                                IsActive="{x:Bind IsLaunching, Mode=OneWay}"
                                                Visibility="{x:Bind IsLaunching, Mode=OneWay}" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <StackPanel Spacing="3">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                                        Text="{x:Bind Description, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind Path, Mode=OneWay}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        MinWidth="0"
                                                        Padding="6,2"
                                                        Click="OnCopyPathClick"
                                                        ToolTipService.ToolTip="Копировать путь в буфер обмена"
                                                        Visibility="{x:Bind HasPath, Mode=OneWay}">
                                                        <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <ItemsControl
                                                ItemsSource="{x:Bind Windows, Mode=OneWay}"
                                                Visibility="{x:Bind HasWindows, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="p:WindowListItemViewModel">
                                                        <Border
                                                            Margin="0,2,0,0"
                                                            Padding="10,6"
                                                            Background="{StaticResource GlazeElevatedBrush}"
                                                            CornerRadius="6">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontSize="14"
                                                                    Foreground="{x:Bind ActiveBrush, Mode=OneWay}"
                                                                    Text="{x:Bind ActiveGlyph, Mode=OneWay}" />

                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock
                                                                        FontSize="12.5"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                                        Text="{x:Bind Title, Mode=OneWay}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="{x:Bind ActiveBrush, Mode=OneWay}"
                                                                            Text="{x:Bind StateText, Mode=OneWay}" />
                                                                        <TextBlock
                                                                            FontSize="11"
                                                                            Foreground="{StaticResource GlazeTextMutedBrush}"
                                                                            Text="{x:Bind MonitorLabel, Mode=OneWay}"
                                                                            Visibility="{x:Bind HasMonitor, Mode=OneWay}" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <StackPanel
                                                                    Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="6"
                                                                    VerticalAlignment="Center">
                                                                    <Button
                                                                        MinWidth="64"
                                                                        Padding="10,4"
                                                                        FontSize="11"
                                                                        Command="{x:Bind FocusCommand}"
                                                                        Content="Фокус" />
                                                                    <Button
                                                                        MinWidth="68"
                                                                        Padding="10,4"
                                                                        FontSize="11"
                                                                        Command="{x:Bind MinimizeCommand}"
                                                                        Content="Свернуть" />
                                                                    <Button
                                                                        MinWidth="76"
                                                                        Padding="10,4"
                                                                        FontSize="11"
                                                                        Command="{x:Bind MaximizeCommand}"
                                                                        Content="Развернуть" />
                                                                    <Button
                                                                        MinWidth="64"
                                                                        Padding="10,4"
                                                                        FontSize="11"
                                                                        Command="{x:Bind CloseCommand}"
                                                                        Content="Закрыть" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <Border
                                            Grid.Column="2"
                                            Padding="10,3"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource GlazeElevatedBrush}"
                                            CornerRadius="6">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{StaticResource GlazeTextMutedBrush}"
                                                Text="{x:Bind TypeBadge, Mode=OneWay}" />
                                        </Border>
                                    </Grid>

                                    <Border
                                        Width="4"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource GlazeAccentBrush}"
                                        CornerRadius="12,0,0,12"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Приложения не найдены"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

                    <ProgressBar
                        Grid.Row="1"
                        Padding="0,8,0,0"
                        IsIndeterminate="True"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

                    <StackPanel
                        Grid.Row="1"
                        Padding="0,14,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            MinWidth="100"
                            Click="OnLaunchClick"
                            Content="Запустить" />
                        <Button
                            MinWidth="100"
                            Click="OnCloseClick"
                            Content="Закрыть" />
                        <Button
                            MinWidth="100"
                            Click="OnRestartClick"
                            Content="Перезапустить" />
                        <Button
                            MinWidth="150"
                            Click="OnTerminateClick"
                            Content="Завершить принудительно" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="36,14,36,20"
                Background="{StaticResource GlazeSurfaceBrush}">
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource GlazeTextMutedBrush}"
                        Text="Логи и данные: %LOCALAPPDATA%\GlazeShell" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Правая колонка: панель мониторов на всю высоту окна.  -->
        <Border
            Grid.Column="1"
            Padding="20,24,20,20"
            Background="{StaticResource GlazeSurfaceBrush}"
            BorderBrush="{StaticResource GlazeBorderBrush}"
            BorderThickness="1,0,0,0">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                    Text="МОНИТОРЫ" />
                <TextBlock
                    Grid.Row="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                    Text="{x:Bind ViewModel.MonitorSummary, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Monitors, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="p:MonitorListItemViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    Background="{StaticResource GlazeElevatedBrush}"
                                    CornerRadius="8">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Foreground="{StaticResource GlazeAccentBrush}"
                                                Glyph="&#xE7F4;" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                    Text="{x:Bind DisplayName, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind DeviceName, Mode=OneWay}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                                    Text="{x:Bind Label, Mode=OneWay}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{StaticResource GlazeTextMutedBrush}"
                                                    Text="{x:Bind Summary, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                                <Border
                                                    Padding="8,2"
                                                    HorizontalAlignment="Right"
                                                    Background="{StaticResource GlazeSurfaceBrush}"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource GlazeTextSecondaryBrush}"
                                                        Text="{x:Bind Badge, Mode=OneWay}" />
                                                </Border>
                                                <Button
                                                    MinWidth="0"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Right"
                                                    Click="OnRenameMonitorClick"
                                                    Content="Имя"
                                                    FontSize="11"
                                                    ToolTipService.ToolTip="Переименовать дисплей" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource GlazeTextMutedBrush}"
                                            Text="{x:Bind WindowCountText, Mode=OneWay}" />

                                        <ItemsControl ItemsSource="{x:Bind Windows, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="p:WindowListItemViewModel">
                                                    <Grid Margin="4,0,0,0" ColumnSpacing="6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock
                                                            FontSize="11"
                                                            Foreground="{x:Bind ActiveBrush, Mode=OneWay}"
                                                            Text="{x:Bind ActiveGlyph, Mode=OneWay}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontSize="11"
                                                            Foreground="{StaticResource GlazeTextPrimaryBrush}"
                                                            Text="{x:Bind Title, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            FontSize="11"
                                                            Foreground="{x:Bind ActiveBrush, Mode=OneWay}"
                                                            Text="{x:Bind StateText, Mode=OneWay}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
