<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GlazeShell.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#12151B">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="36,30,36,26"
            Background="#1B1F27">
            <StackPanel Spacing="8">
                <TextBlock
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="#F4F6FA"
                    Text="Glaze Shell" />
                <TextBlock
                    FontSize="14"
                    Foreground="#98A2B3"
                    Text="Оболочка рабочего окружения поверх штатных возможностей Windows"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid
            Grid.Row="1"
            Margin="36,28,36,28"
            ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="22"
                Background="#1B1F27"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="12"
                        Foreground="#6E7A8A"
                        Text="ОБОЛОЧКА" />
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="Stage 0 · Foundation"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="13"
                        Foreground="#98A2B3"
                        Text="WinUI 3 приложение, сборка решения, конфигурация и файловое логирование."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="1"
                Padding="22"
                Background="#1B1F27"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="12"
                        Foreground="#6E7A8A"
                        Text="ЯДРО" />
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="Stage 1 · Core"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="13"
                        Foreground="#98A2B3"
                        Text="Доменные модели, контракты интерфейсов, события и базовые сервисы."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Column="2"
                Padding="22"
                Background="#1B1F27"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="12"
                        Foreground="#6E7A8A"
                        Text="СЛЕДУЮЩИЙ ЭТАП" />
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#F4F6FA"
                        Text="Stage 2 · Discovery"
                        TextWrapping="Wrap" />
                    <TextBlock
                        FontSize="13"
                        Foreground="#98A2B3"
                        Text="Обнаружение установленных приложений и запуск процесса оболочки."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="36,18,36,20"
            Background="#1B1F27">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="12"
                    Foreground="#6E7A8A"
                    Text="Данные приложения и логи: %LOCALAPPDATA%\GlazeShell" />
                <TextBlock
                    FontSize="12"
                    Foreground="#4E5866"
                    Text="Интерфейс и оформление появятся на следующих этапах roadmap."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
