{
  "$name": "Glaze Shell design tokens",
  "$version": "1.0",
  "color": {
    "brand": { "sky": "#64D2FF", "cobalt": "#5E7BFF", "orchid": "#BF5AF2", "primary": "#6A5BEA" },
    "gradient": { "glaze": "linear-gradient(155deg, #64D2FF 0%, #5E7BFF 50%, #BF5AF2 100%)", "glaze-ui": "linear-gradient(135deg, #64D2FF, #5E7BFF 55%, #BF5AF2)" },
    "pastel": {
      "mint":   { "light": "#A8F0DA", "deep": "#4FD1B0" },
      "sky":    { "light": "#A5DCFF", "deep": "#5AA9F5" },
      "lilac":  { "light": "#D5C6FF", "deep": "#9179F0" },
