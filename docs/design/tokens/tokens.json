      "window-fill": "rgba(255,255,255,.62)", "card-fill": "rgba(255,255,255,.62)", "panel-fill": "rgba(255,255,255,.5)",
      "line": "rgba(90,70,200,.10)", "selection": "rgba(106,91,234,.13)", "field": "rgba(70,55,170,.07)", "shadow": "rgba(90,70,200,.18)"
    },
    "dark": {
      "night": "#14122B", "surface": "#1E1B3D", "elevated": "#2A2754", "divider": "#3A3670",
      "text": "#F4F1FF", "text-2": "#B2AED8", "text-3": "#7773A8", "accent": "#A99BFF",
      "glass-fill": "rgba(34,30,74,.55)", "glass-border": "rgba(255,255,255,.14)",
      "window-fill": "rgba(30,27,66,.62)", "card-fill": "rgba(255,255,255,.07)", "panel-fill": "rgba(255,255,255,.05)",
      "line": "rgba(255,255,255,.09)", "selection": "rgba(169,155,255,.20)", "field": "rgba(255,255,255,.08)", "shadow": "rgba(0,0,0,.40)"
