    "accent-options": { "cobalt": "#5E7BFF", "orchid": "#BF5AF2", "rose": "#FF6F9F", "peach": "#FF9A76", "mint": "#3FCF9B", "slate": "#8A88B5" },
    "light": {
      "cloud": "#F6F4FF", "surface": "#FFFFFF", "panel": "#ECE8FF", "divider": "#DDD8F5",
