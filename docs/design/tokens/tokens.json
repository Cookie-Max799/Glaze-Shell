  "material": {
    "glass": { "blur": "28px", "saturate": "170%", "border-width": "1px" },
    "shadow-rule": "Shadows are tinted with the colour of the object (icon, folder), alpha .3-.4, never neutral black on light theme"
  },
  "radius": { "window": 36, "panel": 26, "widget": 32, "card": 24, "dock": 36, "popover": 32, "nav-item": 16, "nav-chip": 10, "toggle": 20, "tile": "30%", "pill": 999 },
  "typography": {
    "body": "Figtree, 'Segoe UI', system-ui, sans-serif",
    "heading": "Poppins, 'Segoe UI', sans-serif",
    "weights": { "body": 500, "emphasis": 600, "strong": 700 },
    "size": { "ui": 14.5, "small": 13, "caption": 11.5, "section-label": 11.5, "window-title": 23, "popover-title": 19, "clock": 62 },
